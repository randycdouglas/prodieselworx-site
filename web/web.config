<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!--
      hostingModel="inprocess" requires the site's application pool to be set to
      "No Managed Code". If IIS returns 500.19 or 502.5, the per-site .NET version
      does not match this project's target framework.
    -->
    <aspNetCore processPath="dotnet"
                arguments=".\ProDieselWorx.Web.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <!--
        Contact-form secrets are intentionally NOT committed here. Configure these
        as host environment variables (or ASP.NET configuration) on the server:
          RESEND_API_KEY
          RESEND_FROM_EMAIL
          CONTACT_TO_EMAIL
      -->
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
